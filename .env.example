# PostgreSQL (dummy development values only)
POSTGRES_DB=speak_note
POSTGRES_USER=speak_note
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://speak_note:change-me@postgres:5432/speak_note

# Host user used by Backend/Worker for bind-mounted storage permissions
SPEAK_NOTE_UID=1000
SPEAK_NOTE_GID=1000

# Backend / storage
BACKEND_PORT=8001
CORS_ORIGINS=http://localhost:3000
WORKER_POLL_INTERVAL_SECONDS=2
STORAGE_ROOT=/app/storage
MAX_AUDIO_UPLOAD_MB=1024
MAX_VIDEO_UPLOAD_MB=4096
UPLOAD_CHUNK_MB=50
REALTIME_CHUNK_MS=15000
REALTIME_WINDOW_MS=30000
REALTIME_MAX_CHUNK_MB=64
REALTIME_RESUME_TIMEOUT_SECONDS=600
REALTIME_ANALYSIS_INTERVAL_MS=30000
REALTIME_ANALYSIS_DRAFT_TAIL_MS=2000
REALTIME_ANALYSIS_TIMEOUT_SECONDS=300

# Frontend
FRONTEND_PORT=3000
BACKEND_INTERNAL_URL=http://backend:8001
NEXT_ALLOWED_DEV_ORIGINS=localhost,192.168.0.126,note.example.com

# LAN HTTPS (set this to the Ubuntu server LAN address)
SPEAK_NOTE_HTTPS_HOST=192.168.0.126
HTTPS_PORT=3443

# Cloudflare Tunnel (dummy value; put the real token only in .env)
CLOUDFLARE_TUNNEL_TOKEN=dummy-cloudflare-tunnel-token

# WhisperX (replace the dummy key locally; never commit a real key)
WHISPERX_BASE_URL=http://host.docker.internal:8000
WHISPERX_API_KEY=dummy-whisperx-key
WHISPERX_MODEL=large-v3
WHISPERX_LANGUAGE=ja
WHISPERX_TIMEOUT_SECONDS=7200
WHISPERX_MAX_ATTEMPTS=3
WHISPERX_RETRY_DELAY_SECONDS=1

# Phase 4 AI settings
# Generate a unique Fernet key as described in README.md. Never commit the real value.
MASTER_ENCRYPTION_KEY=
# Long-running structured minutes request timeout
LLM_TIMEOUT_SECONDS=1800
OLLAMA_NUM_CTX=65536
# Private Ollama hosts must be explicitly allowed. Comma-separated hostnames/IPs only.
OLLAMA_ALLOWED_HOSTS=host.docker.internal,localhost,127.0.0.1

# Azure AI Speech credentials are encrypted and saved from the AI settings screen.
AZURE_SPEECH_TIMEOUT_SECONDS=60
AZURE_SPEECH_MAX_ATTEMPTS=3
AZURE_SPEECH_RETRY_DELAY_SECONDS=1

